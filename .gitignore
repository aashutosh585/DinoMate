# ====================================================================
# 🦕 Dino_Mate — Comprehensive Project Root .gitignore
# Covers Java Spring Boot, Maven, React, Vite, Node, IDEs & OS Files
# ====================================================================

# --------------------------------------------------
# Environment & Secrets (Never commit credentials!)
# --------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env.local
*.env.*.local

# Spring Boot sensitive configurations
**/src/main/resources/application.properties
**/src/main/resources/application-local.properties
**/src/main/resources/application-prod.properties
!**/src/main/resources/application.properties.example
!**/src/main/resources/application-dev.properties

# Secrets, certificates, and keys
*.pem
*.key
*.p12
*.crt
credentials.json

# --------------------------------------------------
# Java & Maven Build Artifacts
# --------------------------------------------------
target/
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/

*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

.vscode


# Maven wrapper jar (uncomment if wrapper jar is not tracked)
# .mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
HELP.md

# --------------------------------------------------
# Frontend & Node.js Artifacts (Vite / React)
# --------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------
# IDEs & Code Editors
# --------------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iws
*.iml
**/*.iml
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Sublime / Atom / Vim
*.sublime-workspace
*.sublime-project
*.sw?
*~
.*.sw[a-z]
*.bak

# --------------------------------------------------
# Operating System Files
# --------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory

# --------------------------------------------------
# Crash / Diagnostic dumps
# --------------------------------------------------
hs_err_pid*
replay_pid*
